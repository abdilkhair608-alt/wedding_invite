  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "~3.4.17",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
