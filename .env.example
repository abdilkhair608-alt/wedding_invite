# Vercel: connect a PRIVATE Blob store to this project in the Storage dashboard.
# Vercel automatically provides BLOB_READ_WRITE_TOKEN (or OIDC/store credentials).
# Set real credentials only in Vercel Environment Variables or an ignored .env file.
# Do not prefix credentials with VITE_. Do not paste tokens into chat/GitHub.
BLOB_READ_WRITE_TOKEN=
# Optional namespace. Leave empty for separate production and preview responses.
RSVP_BLOB_PREFIX=

# Local Node server only (npm run dev / npm start): JSON on permanent disk.
RSVP_FILE=.data/rsvp.json
HOST=127.0.0.1
PORT=3000
